{
  "slug": "cmdb",
  "title": "发现扫描新鲜度与关系缺口",
  "fields": [
    {
      "key": "id",
      "label": "记录编号",
      "type": "ID"
    },
    {
      "key": "lastDiscovered",
      "label": "最后发现日",
      "type": "DATE"
    },
    {
      "key": "maxAgeDays",
      "label": "最长扫描间隔天数",
      "type": "NUMBER",
      "scale": 0,
      "min": "0",
      "max": "3650"
    },
    {
      "key": "expectedLinks",
      "label": "应有关系数",
      "type": "NUMBER",
      "scale": 0,
      "min": "0",
      "max": "1000000"
    },
    {
      "key": "confirmedLinks",
      "label": "已确认关系数",
      "type": "NUMBER",
      "scale": 0,
      "min": "0",
      "max": "1000000"
    },
    {
      "key": "ownerAssigned",
      "label": "责任人已分配",
      "type": "ENUM",
      "options": [
        "YES",
        "NO"
      ]
    }
  ],
  "columns": [
    {
      "key": "discoveryAgeDays",
      "label": "发现距今天数"
    },
    {
      "key": "missingLinks",
      "label": "关系缺口"
    },
    {
      "key": "confirmedLinkPct",
      "label": "关系确认覆盖%"
    }
  ],
  "description": "核对最近发现时间、输入扫描时限、应有关联和已确认关联，突出过期或孤立CI，不启动网络扫描。",
