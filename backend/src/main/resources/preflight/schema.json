{
  "slug": "cmdb",
  "title": "配置项生命周期与依赖预检",
  "fields": [
    {
      "key": "ci_no",
      "label": "配置项编号",
      "type": "ID",
      "length": 200
    },
    {
      "key": "name",
      "label": "名称",
      "type": "TEXT",
      "length": 200
    },
    {
      "key": "depends_on",
      "label": "依赖配置项",
      "type": "ID",
      "length": 200
    },
    {
      "key": "owner",
      "label": "责任人",
      "type": "ID",
      "length": 200
    },
    {
      "key": "commissioned",
      "label": "投运日期",
      "type": "DATE",
      "length": 200
    },
    {
      "key": "retire_date",
      "label": "计划退役",
      "type": "DATE",
      "length": 200
    }
  ],
  "unique": [
    [
      "ci_no"
    ]
  ],
  "rules": [
    {
      "op": "DIFFERENT",
      "args": [
        "ci_no",
        "depends_on"
      ],
      "code": "CI_SELF_DEPENDENCY",
      "message": "配置项不能直接依赖自身",
      "bad": {
        "depends_on": "CI-001"
      }
    },
    {
      "op": "DATE_LE",
      "args": [
        "commissioned",
        "retire_date"
      ],
      "code": "CI_DATE",
      "message": "退役日期不得早于投运日期",
      "bad": {
        "retire_date": "2024-12-31"
      }
    }
  ],
  "sampleCsv": "ci_no,name,depends_on,owner,commissioned,retire_date\nCI-001,示例应用,CI-002,USER-01,2025-01-01,2027-12-31\n",
  "limits": {
    "rows": 500,
    "bytes": 262144,
    "columns": 32,
    "cellCharacters": 4000
  },
  "scope": "Read-only batch validation; no persistence, reference-master lookup or full production certification."
}
